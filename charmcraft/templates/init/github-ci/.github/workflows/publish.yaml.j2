name: Publish to edge

on:
  workflow_call:
    secrets:
      CHARMHUB_TOKEN:
        required: true
  workflow_dispatch:

permissions: {}

jobs:
  publish-edge:
    name: Publish to latest/edge
    runs-on: ubuntu-latest
    # Required to access secrets.CHARMHUB_TOKEN
    environment: publish
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false

      - name: Set up LXD
        uses: canonical/setup-lxd@8c6a87bfb56aa48f3fb9b830baa18562d8bfd4ee  # v1
        with:
          channel: 5.21/stable

      - name: Install charmcraft
        run: sudo snap install --classic charmcraft

      - name: Pack the charm
        run: charmcraft pack

      # An example of uploading a charm with a resource. Remove this
      # step and the '--resource' option in the Upload charm step if your charm
      # doesn't have any resources.
      - name: Find the resource to attach
        id: resource
        run: |
          set -euo pipefail

          # Read the charm name from charmcraft.yaml.
          charm_name=$(yq -r '.name' charmcraft.yaml)

          # Latest uploaded revisions of the resource, as JSON
          # This assumes the resource is a multi-arch OCI image, so the latest
          # revision works for every platform. If the resource is per-arch or a
          # binary, you need to build and upload it per platform instead.
          revisions=$(charmcraft resource-revisions "$charm_name" "$RESOURCE_NAME" --format json)

          # Highest revision number, empty if none has been uploaded
          rev=$(echo "$revisions" | jq -r 'map(.revision) | max // empty')

          # Fail if the resource has no revision: the charm can't be released without it
          if [ -z "$rev" ]; then
            echo "No revision found for resource '$RESOURCE_NAME'. Upload one with 'charmcraft upload-resource' first."
            exit 1
          fi

          echo "Using $RESOURCE_NAME revision $rev"
          echo "name=$RESOURCE_NAME" >> "$GITHUB_OUTPUT"
          echo "revision=$rev" >> "$GITHUB_OUTPUT"
        env:
          CHARMCRAFT_AUTH: {% raw %}${{ secrets.CHARMHUB_TOKEN }}{% endraw %}
          RESOURCE_NAME: some-container-image

      - name: Upload charm to latest/edge
        run: |
          set -euo pipefail

          for charm in *.charm; do
            charmcraft upload "$charm" --release latest/edge --resource "$RESOURCE_NAME:$RESOURCE_REVISION"
          done
        env:
          CHARMCRAFT_AUTH: {% raw %}${{ secrets.CHARMHUB_TOKEN }}{% endraw %}
          RESOURCE_NAME: {% raw %}${{ steps.resource.outputs.name }}{% endraw %}
          RESOURCE_REVISION: {% raw %}${{ steps.resource.outputs.revision }}{% endraw %}
